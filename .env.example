# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# promptfoo reads .env automatically; for the target agent, export these or use
# `set -a; source .env; set +a`.

# ---------------------------------------------------------------------------
# Model credentials
# ---------------------------------------------------------------------------
# A scan spends this key three times over: the target agent's replies,
# promptfoo's attacker model that writes the probes, and the grader.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Only needed with AGENT_MODEL_PROVIDER=openai.
# OPENAI_API_KEY=sk-REPLACE-ME

# ---------------------------------------------------------------------------
# Target agent
# ---------------------------------------------------------------------------
# The toggle the whole POC turns on. false = the weak baseline the red team is
# meant to break. true = system prompt rules, refund authorization,
# read_internal_note disabled, output scrubbing.
AGENT_HARDENED=false

# anthropic | openai | mock
# "mock" is a deterministic keyless stand-in for validating the harness.
AGENT_MODEL_PROVIDER=anthropic

AGENT_ANTHROPIC_MODEL=claude-sonnet-5
# AGENT_OPENAI_MODEL=gpt-4o-mini

# Binds to 127.0.0.1 only. The app refuses to start on any other interface.
AGENT_PORT=8000

# Refund policy cap in cents, enforced when hardened and asserted on always.
AGENT_MAX_REFUND_CENTS=20000

# Turns of history kept per session. Multi-turn strategies need room to
# escalate — crescendo and goat both build up over several turns.
AGENT_MAX_SESSION_TURNS=20

AGENT_AUDIT_LOG=logs/tool_calls.jsonl
